generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  cacNumber            String?
  verificationStatus   OrganizationVerificationStatus @default(PENDING_VERIFICATION)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  events               EventLog[]
  invoices             Invoice[]
  payments             Payment[]
  pickupStops          PickupStop[]
  routes               Route[]
  serviceRequests      ServiceRequest[]
  users                User[]
  zones                Zone[]
}

enum OrganizationVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model User {
  id               String           @id @default(cuid())
  organizationId   String
  email            String?
  phone            String?          @unique
  passwordHash     String?
   role             UserRole         @default(RESIDENT)
  firstName        String?
  lastName         String?
  accountStatus    AccountStatus    @default(UNCLAIMED)
  billingAccountNo String?          @unique
  googleId         String?          @unique
  streetAddress    String?
  landmark         String?
  latitude         Float?
  longitude        Float?
  zoneId           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  invoices         Invoice[]
  payments         Payment[]
  pickupStops      PickupStop[]
  driverRoutes     Route[]
  serviceRequests  ServiceRequest[]
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone             Zone?            @relation(fields: [zoneId], references: [id])

  @@index([organizationId, role])
  @@index([organizationId, zoneId])
}

model Zone {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  boundary       Json?
  color          String?      @default("#d4622b")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pickupStops    PickupStop[]
  routes         Route[]
  residents      User[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, name])
}

model Route {
  id             String       @id @default(cuid())
  organizationId String
  driverId       String
  zoneId         String
  name           String
  date           DateTime
  status         RouteStatus  @default(SCHEDULED)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  stops          PickupStop[]
  driver         User         @relation(fields: [driverId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone           Zone         @relation(fields: [zoneId], references: [id])

  @@index([organizationId, driverId, date])
  @@index([organizationId, zoneId, date])
  @@index([organizationId, date, status])
}

model PickupStop {
  id             String       @id @default(cuid())
  organizationId String
  routeId        String
  residentId     String
  zoneId         String
  stopOrder      Int
  address        String
  latitude       Float?
  longitude      Float?
  status         PickupStatus @default(PENDING)
  completedAt    DateTime?
  photoUrl       String?
  note           String?
  needsReview    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       User         @relation(fields: [residentId], references: [id])
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  zone           Zone         @relation(fields: [zoneId], references: [id])

  @@unique([routeId, residentId])
  @@index([organizationId, routeId, stopOrder])
  @@index([organizationId, status])
}

model ServiceRequest {
  id             String               @id @default(cuid())
  organizationId String
  residentId     String
  type           ServiceRequestType
  status         ServiceRequestStatus @default(PENDING)
  preferredDate  DateTime?
  address        String
  notes          String?
  adminNotes     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       User                 @relation(fields: [residentId], references: [id])

  @@index([organizationId, status, createdAt])
  @@index([organizationId, residentId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  residentId     String
  invoiceNumber  String        @unique
  amount         Int
  currency       String        @default("NGN")
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       User          @relation(fields: [residentId], references: [id])
  payments       Payment[]

  @@index([organizationId, status, dueDate])
  @@index([organizationId, residentId])
}

model Payment {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String
  residentId     String
  provider       PaymentProvider @default(PAYSTACK)
  providerRef    String?         @unique
  amount         Int
  currency       String          @default("NGN")
  status         PaymentStatus   @default(PENDING)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       User            @relation(fields: [residentId], references: [id])

  @@index([organizationId, invoiceId])
  @@index([providerRef])
}

model EventLog {
  id             String       @id @default(cuid())
  organizationId String
  type           EventType
  payload        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
}

enum UserRole {
  ADMIN
  DRIVER
  RESIDENT
}

enum AccountStatus {
  UNCLAIMED
  CLAIMED
}

enum PickupStatus {
  PENDING
  COMPLETED
  MISSED
}

enum ServiceRequestType {
  BULK_SKIP
  ON_DEMAND
  MISSED_PICKUP
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventType {
  ROUTE_CREATED
  ROUTE_STARTED
  ROUTE_COMPLETED
  PICKUP_COMPLETED
  PICKUP_MISSED
  PAYMENT_RECEIVED
  SERVICE_REQUEST_CREATED
}
